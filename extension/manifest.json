{
  "manifest_version": 3,
  "name": "FocusOS — Intelligent Companion",
  "version": "5.0.0",
  "description": "Smart screen-time telemetry sync, ambient blocker, and intentionality coach for FocusOS.",
  "permissions": [
    "storage",
    "alarms",
    "tabs",
    "activeTab",
    "windows"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "FocusOS Companion"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
