  targetEnvironments String   @default("[\"DEVELOPMENT\",\"STAGING\",\"PRODUCTION\"]")
  experimentVariants String   @default("[]") // JSON: [{ variant: "A", weight: 50 }, { variant: "B", weight: 50 }]
