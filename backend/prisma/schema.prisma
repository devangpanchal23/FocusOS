generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                 String         @id @default(uuid())
  email              String         @unique
  passwordHash       String
  name               String
  avatar             String?
  timezone           String         @default("Asia/Kolkata")
  dailyTargetMinutes Int            @default(240) // 4 hours goal
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  profile            Profile?
  devices            Device[]
  screenshots        Screenshot[]
  usageRecords       UsageRecord[]
  dailyMetrics       DailyMetric[]
  
  // Version 2 Relations
  focusProfiles      FocusProfile[]
  focusSessions      FocusSession[]
  automationRules    AutomationRule[]
  automationLogs     AutomationLog[]
  blockRules         BlockRule[]
  blockOverrides     BlockOverride[]
  routineSchedules   RoutineSchedule[]
  gamification       UserGamification?
  achievements       Achievement[]
  notifications      Notification[]
  settings           UserSettings?

  // Version 3 Relations
  aiChatSessions     AiChatSession[]
  aiChatMessages     AiChatMessage[]
  coachingProfile    CoachingProfile?
  smartGoals         SmartGoal[]
  dailyPlans         DailyPlan[]
  behavioralRisks    BehavioralRiskLog[]
  circleMemberships  CircleMember[]
  orgMemberships     OrgMember[]
  apiKeys            ApiKey[]
  webhookSubs        WebhookSubscription[]
  privacyAuditLogs   PrivacyAuditLog[]

  // Version 4 Autonomous Platform Relations
  agentLogs          AiAgentLog[]
  approvalRequests   ActionApprovalRequest[]
  workflows          AiWorkflow[]
  workflowRuns       AiWorkflowExecution[]
  personalContexts   PersonalContext[]
  knowledgeItems     KnowledgeItem[]
  simulations        SimulationScenario[]
  adaptiveModel      AdaptiveProductivityModel?
  reflections        ReflectionEntry[]
  syncQueueItems     SyncQueueItem[]
  integrations       IntegrationApp[]
  subscription       SubscriptionTier?
  invoices           BillingInvoice[]
  governanceAudits   AiGovernanceAudit[]
}

model Profile {
  id            String   @id @default(uuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sleepSchedule String?  @default("23:30 - 07:00")
  workHours     String?  @default("09:00 - 18:00")
  bio           String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Device {
  id           String        @id @default(uuid())
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  deviceType   String        @default("PHONE") // PHONE, LAPTOP, DESKTOP, TABLET, OTHER
  os           String        @default("ANDROID") // ANDROID, WINDOWS, MACOS, IOS, LINUX, OTHER
  timezone     String?       @default("Asia/Kolkata")
  lastSyncAt   DateTime?
  status       String        @default("HEALTHY") // HEALTHY, SYNCING, INACTIVE
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  screenshots  Screenshot[]
  usageRecords UsageRecord[]
}

model Screenshot {
  id           String       @id @default(uuid())
  userId       String
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId     String?
  device       Device?      @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  filePath     String
  fileHash     String       // SHA-256 for duplicate detection
  originalName String
  mimeType     String
  sizeBytes    Int
  status       String       @default("UPLOADED") // UPLOADED, PROCESSING, EXTRACTED, CONFIRMED, FAILED, DUPLICATE
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  extractions  Extraction[]
  usageRecords UsageRecord[]
}

model Extraction {
  id              String            @id @default(uuid())
  screenshotId    String            @unique
  screenshot      Screenshot        @relation(fields: [screenshotId], references: [id], onDelete: Cascade)
  detectedDate    String?           // YYYY-MM-DD
  detectedDevice  String?
  screenshotClass String            @default("UNKNOWN") // ANDROID_DIGITAL_WELLBEING, WINDOWS_BATTERY_USAGE, SHORT_FORM_TRACKER, OTHER
  confidence      Float             @default(0.0) // 0.0 to 1.0
  rawText         String?
  status          String            @default("NEEDS_REVIEW") // NEEDS_REVIEW, CONFIRMED, REJECTED
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  fields          ExtractionField[]
}

model ExtractionField {
  id                 String     @id @default(uuid())
  extractionId       String
  extraction         Extraction @relation(fields: [extractionId], references: [id], onDelete: Cascade)
  fieldKey           String     // "app:Instagram", "totalScreenTime", "notifications", "unlocks", "reelCount"
  detectedValue      String
  confirmedValue     String?
  confidence         Float      @default(0.9)
  categorySuggestion String?
  status             String     @default("DETECTED") // DETECTED, EDITED, CONFIRMED, REJECTED
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
}

model Category {
  id           String        @id @default(uuid())
  name         String        @unique
  color        String        @default("#6366f1")
  isProductive Boolean       @default(false)
  isShortForm  Boolean       @default(false)
  icon         String        @default("Tag")
  createdAt    DateTime      @default(now())

  applications Application[]
  usageRecords UsageRecord[]
}

model Application {
  id                String             @id @default(uuid())
  canonicalName     String             @unique
  icon              String?
  defaultCategoryId String?
  defaultCategory   Category?          @relation(fields: [defaultCategoryId], references: [id], onDelete: SetNull)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  aliases           ApplicationAlias[]
  usageRecords      UsageRecord[]
}

model ApplicationAlias {
  id            String      @id @default(uuid())
  alias         String      @unique
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())
}

model UsageRecord {
  id                String      @id @default(uuid())
  userId            String
  user              User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId          String?
  device            Device?     @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  applicationId     String
  application       Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  categoryId        String?
  category          Category?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  screenshotId      String?
  screenshot        Screenshot? @relation(fields: [screenshotId], references: [id], onDelete: SetNull)
  
  date              String      // YYYY-MM-DD
  activeMinutes     Int         @default(0)
  backgroundMinutes Int         @default(0)
  reelCount         Int         @default(0)
  shortsMinutes     Int         @default(0)
  sessionCount      Int         @default(1)
  source            String      @default("AI_EXTRACTED") // AI_EXTRACTED, USER_ENTERED, ESTIMATED
  confidence        Float       @default(1.0)
  status            String      @default("CONFIRMED") // CONFIRMED, ESTIMATED, REJECTED
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@index([userId, date])
  @@index([userId, deviceId, date])
}

model DailyMetric {
  id                     String   @id @default(uuid())
  userId                 String
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date                   String   // YYYY-MM-DD
  totalScreenTimeMinutes Int      @default(0)
  activeMinutes          Int      @default(0)
  backgroundMinutes      Int      @default(0)
  shortFormMinutes       Int      @default(0)
  productiveMinutes      Int      @default(0)
  entertainmentMinutes   Int      @default(0)
  socialMinutes          Int      @default(0)
  communicationMinutes   Int      @default(0)
  otherMinutes           Int      @default(0)
  reelCount              Int      @default(0)
  notificationCount      Int      @default(0)
  unlockCount            Int      @default(0)
  attentionScore         Int      @default(50) // 0 - 100
  dataConfidence         Float    @default(1.0)
  coverageStatus         String   @default("CONFIRMED") // CONFIRMED, PARTIAL, ESTIMATED
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@unique([userId, date])
}

// ==========================================
// VERSION 2 MODELS
// ==========================================

model FocusProfile {
  id              String         @id @default(uuid())
  userId          String
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String         // "Deep Work", "Coding Sprint", "Study & DSA", "Reading"
  durationMinutes Int            @default(25)
  breakMinutes    Int            @default(5)
  allowedApps     String         @default("[]") // JSON string of app names
  blockedApps     String         @default("[\"Instagram\",\"YouTube\",\"Twitter\"]") // JSON string
  icon            String         @default("Zap")
  color           String         @default("#f59e0b")
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  sessions        FocusSession[]
}

model FocusSession {
  id                String        @id @default(uuid())
  userId            String
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  profileId         String?
  profile           FocusProfile? @relation(fields: [profileId], references: [id], onDelete: SetNull)
  taskName          String        @default("Focused Session")
  durationMinutes   Int           @default(25)
  completedMinutes  Int           @default(0)
  breakMinutes      Int           @default(5)
  distractionsCount Int           @default(0)
  status            String        @default("COMPLETED") // COMPLETED, INTERRUPTED, ABANDONED
  notes             String?
  startedAt         DateTime      @default(now())
  endedAt           DateTime      @default(now())
  createdAt         DateTime      @default(now())
}

model AutomationRule {
  id                String          @id @default(uuid())
  userId            String
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  name              String          // e.g. "Warn when Reels > 45m"
  triggerType       String          // SCREEN_TIME_LIMIT, REELS_LIMIT, FOCUS_START, DAILY_TARGET
  conditionOperator String          // GREATER_THAN, EQUALS, CONTAINS
  thresholdValue    String          // "45", "240"
  actionType        String          // SHOW_NOTIFICATION, BLOCK_APP, START_FOCUS, WARN
  actionTarget      String          // "Instagram", "All Social Media"
  isEnabled         Boolean         @default(true)
  lastTriggeredAt   DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  logs              AutomationLog[]
}

model AutomationLog {
  id          String         @id @default(uuid())
  ruleId      String
  rule        AutomationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  userId      String
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  message     String
  triggeredAt DateTime       @default(now())
}

model BlockRule {
  id          String          @id @default(uuid())
  userId      String
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetType  String          @default("APP") // APP, WEBSITE, CATEGORY
  targetValue String          // "Instagram", "youtube.com", "Social Media"
  mode        String          @default("INSTANT") // INSTANT, FOCUS_ONLY, SCHEDULED
  isEnabled   Boolean         @default(true)
  startTime   String?         // "20:00"
  endTime     String?         // "23:00"
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  overrides   BlockOverride[]
}

model BlockOverride {
  id                      String    @id @default(uuid())
  ruleId                  String
  rule                    BlockRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  userId                  String
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  reason                  String    // e.g. "Need to verify client message"
  overrideDurationMinutes Int       @default(15)
  createdAt               DateTime  @default(now())
}

model RoutineSchedule {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String   // "Deep Work Coding", "Evening Restrict Reels", "Study DSA"
  category    String   @default("Productivity")
  startTime   String   // "10:00"
  endTime     String   // "12:00"
  daysOfWeek  String   @default("[\"MON\",\"TUE\",\"WED\",\"THU\",\"FRI\"]") // JSON array
  isStrict    Boolean  @default(false)
  isEnabled   Boolean  @default(true)
  color       String   @default("#10b981")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model UserGamification {
  id            String    @id @default(uuid())
  userId        String    @unique
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  xp            Int       @default(1450)
  level         Int       @default(4)
  dailyStreak   Int       @default(7)
  focusStreak   Int       @default(5)
  longestStreak Int       @default(12)
  lastActiveDate String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Achievement {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  code        String    // FIRST_FOCUS, STREAK_7_DAYS, SHORTS_CURBED, DEEP_WORK_10H
  title       String
  description String
  icon        String    @default("Award")
  xpReward    Int       @default(100)
  isUnlocked  Boolean   @default(false)
  unlockedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@unique([userId, code])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String   @default("WARNING") // WARNING, LIMIT, FOCUS, ACHIEVEMENT, INSIGHT
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model UserSettings {
  id                     String   @id @default(uuid())
  userId                 String   @unique
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  theme                  String   @default("DARK") // DARK, LIGHT, SYSTEM
  dashboardLayout        String   @default("[\"screenTime\",\"shortForm\",\"attentionScore\",\"focusTime\",\"hotspots\",\"topApps\",\"categories\",\"devices\"]")
  defaultFocusMinutes    Int      @default(25)
  defaultBreakMinutes    Int      @default(5)
  weekStartDay           String   @default("MONDAY")
  notificationPreferences String  @default("{\"reelsWarning\":true,\"goalReached\":true,\"focusReminder\":true}")
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}

// ==========================================
// VERSION 3 MODELS — INTELLIGENT ECOSYSTEM
// ==========================================

model AiChatSession {
  id        String          @id @default(uuid())
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String          @default("Productivity Conversation")
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  messages  AiChatMessage[]
}

model AiChatMessage {
  id        String        @id @default(uuid())
  sessionId String
  session   AiChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String        // USER, ASSISTANT, SYSTEM
  content   String
  metadata  String?       // JSON string of referenced data or action suggestions
  createdAt DateTime      @default(now())
}

model CoachingProfile {
  id                    String   @id @default(uuid())
  userId                String   @unique
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mode                  String   @default("GENERAL") // STUDY, CODING, DEEP_WORK, WELLNESS, EXAM_PREP, GENERAL
  targetDailyFocusHours Float    @default(3.0)
  tone                  String   @default("ENCOURAGING") // ENCOURAGING, DIRECT, ANALYTICAL, CHALLENGING
  lastAdvice            String?
  updatedAt             DateTime @updatedAt
}

model SmartGoal {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title           String   // e.g. "Study 3 hours daily", "Keep Reels under 30m"
  goalType        String   // SCREEN_TIME_LIMIT, FOCUS_HOURS, STUDY_HOURS, CODING_HOURS, REELS_MAX
  targetValue     Float    // target numeric value in minutes or hours
  period          String   @default("DAILY") // DAILY, WEEKLY, MONTHLY
  currentProgress Float    @default(0)
  status          String   @default("ACTIVE") // ACTIVE, COMPLETED, FAILED, PAUSED
  milestones      String   @default("[]") // JSON string of sub-milestones
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model DailyPlan {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      String           // YYYY-MM-DD
  summary   String?
  createdAt DateTime         @default(now())

  blocks    DailyPlanBlock[]

  @@unique([userId, date])
}

model DailyPlanBlock {
  id          String    @id @default(uuid())
  planId      String
  plan        DailyPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  startTime   String    // "09:00"
  endTime     String    // "10:30"
  taskName    String
  category    String    @default("Deep Work")
  isCompleted Boolean   @default(false)
  isFixed     Boolean   @default(false)
}

model BehavioralRiskLog {
  id                   String   @id @default(uuid())
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  riskType             String   // LATE_NIGHT_SPIKE, CONTEXT_SWITCHING, OVERRIDE_FATIGUE, SESSION_DECAY
  severity             String   @default("MEDIUM") // LOW, MEDIUM, HIGH, CRITICAL
  title                String
  description          String
  evidence             String
  actionRecommendation String
  isDismissed          Boolean  @default(false)
  createdAt            DateTime @default(now())
}

model AccountabilityCircle {
  id          String         @id @default(uuid())
  name        String
  description String?
  inviteCode  String         @unique
  creatorId   String
  createdAt   DateTime       @default(now())

  members     CircleMember[]
}

model CircleMember {
  id        String               @id @default(uuid())
  circleId  String
  circle    AccountabilityCircle @relation(fields: [circleId], references: [id], onDelete: Cascade)
  userId    String
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt  DateTime             @default(now())

  @@unique([circleId, userId])
}

model Organization {
  id        String      @id @default(uuid())
  name      String
  slug      String      @unique
  createdAt DateTime    @default(now())

  teams     Team[]
  members   OrgMember[]
  policies  EnterprisePolicy[]
}

model Team {
  id        String      @id @default(uuid())
  orgId     String
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime    @default(now())

  members   OrgMember[]
}

model OrgMember {
  id       String       @id @default(uuid())
  orgId    String
  org      Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  teamId   String?
  team     Team?        @relation(fields: [teamId], references: [id], onDelete: SetNull)
  userId   String
  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     String       @default("MEMBER") // OWNER, ADMIN, MANAGER, MEMBER
  joinedAt DateTime     @default(now())

  @@unique([orgId, userId])
}

model ApiKey {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String    // e.g. "Personal CLI", "Desktop Sync Daemon"
  keyPrefix  String    // "fk_live_..."
  hashedKey  String    @unique
  scopes     String    @default("read:metrics,write:sessions")
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
}

model WebhookSubscription {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  url       String
  secret    String
  events    String   // JSON array: ["focus.completed", "goal.achieved"]
  isEnabled Boolean  @default(true)
  createdAt DateTime @default(now())
}

model PrivacyAuditLog {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String   // EXPORT_CSV, EXPORT_JSON, PURGE_HISTORY, UPDATE_CONSENT
  details   String
  createdAt DateTime @default(now())
}

// ==========================================
// VERSION 4 MODELS — AUTONOMOUS INTELLIGENCE & PLATFORM
// ==========================================

model AiAgentLog {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  agentType       String   // ORCHESTRATOR, PRODUCTIVITY, FOCUS, WELLNESS, PLANNING, ANALYTICS, AUTOMATION
  userQuery       String
  intentDetected  String
  subAgentsUsed   String   // JSON array of subagents invoked
  executionMs     Int
  tokensEstimated Int      @default(150)
  status          String   @default("SUCCESS") // SUCCESS, REFINED, FAILED
  resultPreview   String
  createdAt       DateTime @default(now())
}

model ActionApprovalRequest {
  id              String    @id @default(uuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  actionType      String    // BLOCK_RULE_UPDATE, CALENDAR_EVENT_CREATE, GOAL_ADJUSTMENT, ROUTINE_OVERRIDE, SYSTEM_SETTING
  riskLevel       String    @default("HIGH_IMPACT") // READ_ONLY, LOW_RISK, HIGH_IMPACT
  title           String
  description     String
  previewData     String    // JSON string showing before/after or payload details
  status          String    @default("PENDING") // PENDING, APPROVED, REJECTED, EXECUTED
  requestedBy     String    @default("AI_ORCHESTRATOR") // AI_ORCHESTRATOR, WORKFLOW_ENGINE, ADAPTIVE_MODEL
  executedAt      DateTime?
  resultSummary   String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model AiWorkflow {
  id              String                @id @default(uuid())
  userId          String
  user            User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String
  description     String
  triggerType     String                // SCHEDULED_CRON, SCREEN_TIME_THRESHOLD, FOCUS_COMPLETED, RISK_TRIGGERED, MANUAL
  triggerConfig   String                // JSON: { cron: "0 20 * * 0", thresholdMinutes: 180, etc }
  nodesJson       String                // JSON array of workflow visual nodes
  edgesJson       String                // JSON array of connections
  isEnabled       Boolean               @default(true)
  lastRunAt       DateTime?
  lastRunStatus   String?               // SUCCESS, PENDING_APPROVAL, FAILED
  runCount        Int                   @default(0)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  executions      AiWorkflowExecution[]
}

model AiWorkflowExecution {
  id              String      @id @default(uuid())
  workflowId      String
  workflow        AiWorkflow  @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  userId          String
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  status          String      @default("COMPLETED") // COMPLETED, PENDING_APPROVAL, FAILED
  stepsLogJson    String      // JSON array of step-by-step logs with timestamps and outputs
  durationMs      Int         @default(450)
  startedAt       DateTime    @default(now())
  completedAt     DateTime?
}

model PersonalContext {
  id              String    @id @default(uuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  contextType     String    // SHORT_TERM, LONG_TERM, BEHAVIORAL, GOAL, SCHEDULE
  sourceType      String    // OBSERVED_DATA, USER_PREFERENCE, AI_ASSUMPTION
  key             String    // e.g. "peak_focus_window", "preferred_break_duration", "distraction_trigger"
  value           String    // e.g. "09:30 - 11:45", "7 minutes", "Instagram after 9 PM"
  confidence      Float     @default(1.0) // 0.0 - 1.0 (1.0 for user-provided/observed, 0.6-0.9 for assumptions)
  evidence        String?
  expiresAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([userId, key])
}

model KnowledgeItem {
  id              String    @id @default(uuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  category        String    // NOTE, GOAL, PLAN, REFLECTION, STRATEGY, RULE
  title           String
  content         String
  tags            String    @default("[]") // JSON array of strings
  isPinned        Boolean   @default(false)
  aiCitations     Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([userId, category])
}

model SimulationScenario {
  id                    String   @id @default(uuid())
  userId                String
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                  String
  parametersJson        String   // JSON: { deltaSocialMinutes: -30, extraStudyHours: 1, shiftFocusHour: 9 }
  baselineMetricsJson   String   // JSON: { screenTime: 468, attentionScore: 72, focusHours: 2.5 }
  projectedMetricsJson  String   // JSON: { screenTime: 408, attentionScore: 84, focusHours: 3.5, fatigueDelta: -15 }
  confidenceScore       Float    @default(0.85)
  disclaimer            String   @default("Estimated scenario based on historical telemetry — not guaranteed outcome.")
  createdAt             DateTime @default(now())
}

model AdaptiveProductivityModel {
  id                    String   @id @default(uuid())
  userId                String   @unique
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  optimalFocusMinutes   Int      @default(35)
  optimalBreakMinutes   Int      @default(7)
  peakProductivityHours String   @default("[\"09:30 - 11:30\", \"16:00 - 17:30\"]") // JSON array
  distractionTriggers   String   @default("[\"Late night notification surges\", \"Unscheduled YouTube tab switching\"]") // JSON array
  fatigueThresholdHours Float    @default(4.5)
  learningIterations    Int      @default(14)
  isCustomized          Boolean  @default(false)
  lastCalibratedAt      DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model ReflectionEntry {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  periodType      String   // DAILY, WEEKLY, MONTHLY
  date            String   // YYYY-MM-DD or YYYY-Www
  responsesJson   String   // JSON: { whatWentWell, whatDistracted, improvementGoal, proudOf }
  aiSynthesis     String   // AI-generated summary & recommendations
  recurringThemes String   @default("[]") // JSON array: ["Short-form friction", "Flow state consistency"]
  sentimentScore  Float    @default(0.8) // 0.0 - 1.0
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([userId, periodType, date])
}

model SyncQueueItem {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId        String?
  entityType      String   // FOCUS_SESSION, SMART_GOAL, BLOCK_RULE, AUTOMATION, REFLECTION
  entityId        String
  action          String   // UPSERT, DELETE
  payloadJson     String
  clientTimestamp DateTime @default(now())
  status          String   @default("SYNCED") // QUEUED, SYNCED, CONFLICT_RESOLVED, FAILED
  conflictLog     String?
  createdAt       DateTime @default(now())
}

model IntegrationApp {
  id              String    @id @default(uuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider        String    // GOOGLE_CALENDAR, SPOTIFY, NOTION, GITHUB, SLACK, TODOIST, OBSIDIAN
  name            String
  category        String    // CALENDAR, MUSIC, NOTES, DEV, COMMUNICATION, TASKS
  icon            String
  status          String    @default("CONNECTED") // CONNECTED, DISCONNECTED, ERROR
  scopes          String    @default("read,write")
  configJson      String    @default("{}")
  lastSyncAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([userId, provider])
}

model MarketplaceApp {
  id              String   @id @default(uuid())
  slug            String   @unique
  name            String
  author          String
  category        String   // FOCUS_PACK, AGENT, THEME, AUTOMATION, WIDGET, INTEGRATION
  description     String
  icon            String
  version         String   @default("1.0.0")
  rating          Float    @default(4.9)
  installCount    Int      @default(120)
  permissionsJson String   @default("[\"read:metrics\"]")
  manifestJson    String   @default("{}")
  isOfficial      Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model SubscriptionTier {
  id                  String   @id @default(uuid())
  userId              String   @unique
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  planName            String   @default("PRO") // FREE, PRO, PREMIUM, TEAM, ENTERPRISE
  status              String   @default("ACTIVE") // ACTIVE, TRIALING, PAST_DUE, CANCELED
  currentPeriodEnd    DateTime
  monthlyPriceUsd     Float    @default(12.0)
  featureEntitlements String   @default("{\"multiAgent\":true,\"workflows\":true,\"simulations\":true,\"integrations\":true,\"enterprise\":false}")
  usageLimits         String   @default("{\"aiQueriesPerMonth\":1000,\"workflowLimit\":25,\"deviceLimit\":10}")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model BillingInvoice {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  invoiceNumber   String   @unique
  amountUsd       Float
  currency        String   @default("USD")
  status          String   @default("PAID") // PAID, PENDING, FAILED
  planName        String   @default("PRO")
  billingDate     DateTime @default(now())
  pdfDownloadUrl  String   @default("/api/v4/billing/invoices/mock-download")
  createdAt       DateTime @default(now())
}

model EnterprisePolicy {
  id               String       @id @default(uuid())
  orgId            String
  organization     Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  policyKey        String       // SSO_ENFORCEMENT, AUDIT_RETENTION_DAYS, DATA_RESIDENCY, SCIM_PROVISIONING, RBAC_STRICT_MODE
  policyValueJson  String
  enforcementLevel String       @default("MANDATORY") // MANDATORY, ADVISORY, DISABLED
  updatedBy        String       @default("SYSTEM_ADMIN")
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@unique([orgId, policyKey])
}

model AiGovernanceAudit {
  id                String   @id @default(uuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  promptSummary     String
  modelRouted       String   // GEMINI_PRO, GEMINI_FLASH, LOCAL_HEURISTIC
  latencyMs         Int
  tokensUsed        Int
  costUsd           Float    @default(0.00015)
  riskScore         Float    @default(0.05) // 0.0 to 1.0
  sensitiveFiltered Boolean  @default(false)
  toolsInvoked      String   @default("[]") // JSON array
  approvedBy        String?  // HUMAN_USER, AUTO_POLICY
  status            String   @default("APPROVED") // APPROVED, FLAGGED, REJECTED
  createdAt         DateTime @default(now())
}

model FeatureFlag {
  id                 String   @id @default(uuid())
  flagKey            String   @unique
  description        String
