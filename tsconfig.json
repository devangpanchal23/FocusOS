{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "esModuleInterop": true,
    "allowJs": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "noEmit": true
  },
  "include": [
    "backend/src/**/*",
    "backend/prisma/**/*",
    "backend/test/**/*",
    "api/**/*"
  ],
  "exclude": [
    "**/node_modules",
    "**/dist"
  ]
}
